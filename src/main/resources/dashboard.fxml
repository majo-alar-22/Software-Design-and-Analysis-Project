<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.DashboardController"
            styleClass="root">

    <top>
        <VBox spacing="10" styleClass="header">
            <padding><Insets top="18" right="22" bottom="12" left="22"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="⚽" styleClass="logo"/>
                <VBox spacing="3">
                    <Label fx:id="welcomeLabel" text="Welcome!" styleClass="title"/>
                    <Label text="Teams • Scheduling • Results" styleClass="subtitle"/>
                </VBox>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="LOG OUT" onAction="#onLogout" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="14" styleClass="card" BorderPane.alignment="TOP_CENTER">
            <padding><Insets top="18" right="22" bottom="22" left="22"/></padding>
            <Label text="Dashboard" styleClass="fieldLabel"/>
            <Label text="Next: create/join teams, schedule matches, submit results."
                   styleClass="subtitle"/>
        </VBox>
    </center>

</BorderPane>
