<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/23"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="app.LoginController"
            styleClass="root">

    <top>
        <VBox spacing="10" styleClass="header" BorderPane.alignment="CENTER">
            <padding><Insets top="22" right="22" bottom="16" left="22"/></padding>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="⚽" styleClass="logo"/>
                <VBox spacing="4">
                    <Label text="WELCOME BACK" styleClass="title"/>
                    <Label text="Log in to manage teams, schedules, and results."
                           styleClass="subtitle"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="14" styleClass="card" BorderPane.alignment="TOP_CENTER">
            <padding><Insets top="18" right="22" bottom="22" left="22"/></padding>

            <Label fx:id="statusLabel" text="" styleClass="status" visible="false" managed="false"/>

            <VBox spacing="10">
                <Label text="Email" styleClass="fieldLabel"/>
                <HBox fx:id="emailRow" spacing="10" styleClass="fieldRow">
                    <Label text="✉️" styleClass="icon"/>
                    <TextField fx:id="emailField" promptText="you@example.com" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox spacing="10">
                <Label text="Password" styleClass="fieldLabel"/>
                <HBox fx:id="passRow" spacing="10" styleClass="fieldRow">
                    <Label text="🔒" styleClass="icon"/>
                    <PasswordField fx:id="passwordField" promptText="Your password" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <Button fx:id="loginBtn"
                    text="LOG IN"
                    onAction="#onLogin"
                    styleClass="cta"
                    maxWidth="Infinity"/>

            <Hyperlink text="Don’t have an account? Create one"
                       onAction="#onGoSignup"
                       styleClass="footer"/>
        </VBox>
    </center>
</BorderPane>
